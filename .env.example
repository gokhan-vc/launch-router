# Bot that opens the Mini App. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Public HTTPS origin of the Mini App (Worker URL or launch.numetal.xyz).
MINIAPP_URL=https://launch.numetal.xyz/app.html

# Optional — required to sign *inside* Telegram (no window.ethereum there).
# Put these in packages/telegram/.env.local (gitignored). App id / project id only — never a Privy secret.
VITE_WC_PROJECT_ID=
VITE_PRIVY_APP_ID=
