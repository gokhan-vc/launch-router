{
  "name": "launch-router",
  "main": "packages/telegram/src/worker.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./packages/telegram/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/telegram/*", "/api/*"]
  },
  "observability": { "enabled": true }
}
